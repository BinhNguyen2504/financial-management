# Without Auth configuration, public landing works and app pages redirect to login setup.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Connect as expense_api, never postgres or service_role.
# Apply all supabase/migrations/*.sql in order and enable LOGIN first.
DATABASE_URL=
# Cloud connections require TLS. Use disable ONLY with an isolated local test DB.
DATABASE_SSL=require
# Canonical origin: use your actual public HTTPS domain (no trailing path).
# Set to the deployed origin for social metadata and reverse-proxy redirects.
# Blank uses Host detection for requests and localhost:3000 for metadata.
APP_ORIGIN=
# Opt in only on production with a public HTTPS APP_ORIGIN, then rebuild.
# Vercel preview/development deployments remain noindex even when true.
SEO_INDEXABLE=false

# Full JSON backup/import limit. Hosting/proxy must accept this size plus 1 KiB envelope.
DATA_BACKUP_MAX_BYTES=20971520
