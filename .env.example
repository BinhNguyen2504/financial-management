# Without these values, /budgets and /income shows the setup state and writes no financial data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Connect as expense_api, never postgres or service_role.
# Apply all supabase/migrations/*.sql in order and enable LOGIN first.
DATABASE_URL=
# Cloud connections require TLS. Use disable ONLY with an isolated local test DB.
DATABASE_SSL=require
# Canonical public origin, e.g. https://your-app.example (no trailing path).
# Recommended behind a reverse proxy; leave blank for local Host-based detection.
APP_ORIGIN=
