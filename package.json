{
  "name": "financial-manager",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "mcp:playwright": "playwright-mcp --browser chrome --headless --isolated --viewport-size 1440x900 --output-dir artifacts/playwright",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:db": "node scripts/test-postgres.mjs",
    "test:e2e": "node scripts/test-postgres.mjs --browser",
    "data:sample": "node scripts/sample-data.mjs",
    "data:savings:sample": "node scripts/sample-savings.mjs",
    "data:investments:sample": "node scripts/sample-investments.mjs",
    "data:preview": "node scripts/preview-sample-data.mjs",
    "data:import": "node --env-file=.env.local scripts/import-sample-data.mjs",
    "check": "npm test && npm run typecheck && npm run build",
    "data:funds:sample": "node scripts/run-typescript.mjs scripts/sample-funds.ts",
    "data:funds:import": "node --env-file=.env.local scripts/run-typescript.mjs scripts/import-funds.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "1.57.0",
    "next": "16.4.1",
    "postgres": "^3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/mcp": "0.0.83",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "^3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "^5.0.5"
  }
}
