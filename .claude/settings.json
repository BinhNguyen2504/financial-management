{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run lint:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npm run format:check:*)",
      "Bash(npm run check:architecture:*)",
      "Bash(npm run check:*)",
      "Bash(npm test:*)",
      "Bash(npx vitest:*)",
      "Bash(npx prettier --check:*)",
      "Bash(source ~/.nvm/nvm.sh:*)",
      "Bash(nvm use:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./.env.*.local)",
      "Read(./Notion/**)",
      "Read(./imports/**)",
      "Read(./backups/**)",
      "Bash(npm run data:import:*)",
      "Bash(npm run data:funds:import:*)",
      "Bash(npm run data:goals:review:*)"
    ]
  },
  "enabledMcpjsonServers": ["playwright"],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-edited.mjs\""
          }
        ]
      }
    ]
  }
}
